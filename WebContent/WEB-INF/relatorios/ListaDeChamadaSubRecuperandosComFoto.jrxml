<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ListaDeChamadaSubRecuperandos" pageWidth="555" pageHeight="802" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" whenResourceMissingType="Empty" uuid="ca5d2853-6c77-4890-b361-6e38863346bc">
	<property name="ireport.zoom" value="1.650000000000002"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="EMISSOR" class="java.lang.String"/>
	<parameter name="NOME_DO_RELATORIO" class="java.lang.String"/>
	<parameter name="CABECALHO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["cabecalhos\\CabecalhoPadrao.jasper"]]></defaultValueExpression>
	</parameter>
	<parameter name="RODAPE" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["cabecalhos\\RodapePadrao.jasper"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUB_ESTRUTURA_ID" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="SUB_SCHEMA" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[select (select listagg(e.nome, ' > ') within group(order by e.id) cela
          from $P!{SUB_SCHEMA}.estrutura e
         where e.estruturapai_id is not null
         start with e.id = recup.estrutura_id
        connect by e.id = prior e.estruturapai_id) cela,
        recup.id, recup.nome, recup.nome_social, recup.nome_mae, recup.data_nascimento, recup.em_movimento, recup.foto
       from (select
       r.id,
       p.nome,
p.nome_social,
       p.nome_mae,
       p.data_nascimento,
       es.id estrutura_id,
       (case
         when pt.status in ('EM_ANDAMENTO', 'SUSPENSO') then
          'SIM'
         else
          'NAO'
       end) em_movimento,
i.arquivo foto
  from $P!{SUB_SCHEMA}.estrutura        es,
       $P!{SUB_SCHEMA}.recuperando      r,
       $P!{SUB_SCHEMA}.pessoa           p,
       $P!{SUB_SCHEMA}.passagem         pa,
       $P!{SUB_SCHEMA}.passagem_lotacao pal,
       $P!{SUB_SCHEMA}.pedido_transito  pt,
       $P!{SUB_SCHEMA}.foto             f,
       $P!{SUB_SCHEMA}.imagem           i
 where r.pessoa_id = p.id(+)
   and pa.id(+) = pal.passagem_id
   and pal.estrutura_id(+) = es.id
   and pa.recuperando_id = r.id(+)
   and pal.data_saida is null
   and pt.recuperando_id(+) = r.id
   and pt.data_conclusao(+) is null
   and pt.status(+) in ('SUSPENSO', 'EM_ANDAMENTO')
   and f.recuperando_id(+) = r.id
   and f.imagem_id = i.id(+)
   and pa.recuperando_id is not null
   and f.is_atual = 1
   and f.tipo = 1
   start with es.id = $P!{SUB_ESTRUTURA_ID}
   connect by prior es.id = es.estruturapai_id
 order by es.estruturapai_id, es.id, p.nome) recup]]>
	</queryString>
