	</parameter>
	<parameter name="UNIDADE_LOGADA" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="EMISSOR" class="java.lang.String"/>
	<parameter name="NOME_DO_RELATORIO" class="java.lang.String"/>
	<parameter name="TEM_PAGINACAO" class="java.lang.Boolean">
		<defaultValueExpression><![CDATA[true]]></defaultValueExpression>
	</parameter>
	<parameter name="CABECALHO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["cabecalhos\\CabecalhoPadrao.jasper"]]></defaultValueExpression>
	</parameter>
	<parameter name="RODAPE" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["cabecalhos\\RodapePadrao.jasper"]]></defaultValueExpression>
	</parameter>
	<parameter name="ID_ESTRUTURA" class="java.lang.Long"/>
	<parameter name="SCHEMA" class="java.lang.String"/>
	<queryString>
		<![CDATA[select level nivel,
       e.id estrutura_id,
        (case when level > 1 then lpad('>', level*level, ' ') end) || e.nome est_nome,
       e.capacidade,
       (select sum(e2.capacidade)
          from $P!{SCHEMA}.estrutura e2
         start with e2.id = e.id
        connect by prior e2.id = e2.estruturapai_id) capacidade_total,
       (select sum(nvl(qt.qtd_recuperandos_estrutura, 0))
          from $P!{SCHEMA}.qtd_recuperandos_por_estrutura qt, $P!{SCHEMA}.estrutura e3
         where qt.estrutura_id(+) = e3.id
         start with e3.id = e.id
        connect by prior e3.id = e3.estruturapai_id) qtd_recuperandos
  from $P!{SCHEMA}.estrutura e
 start with e.id = $P{ID_ESTRUTURA}
connect by prior e.id = e.estruturapai_id
 order siblings by e.id]]>
	</queryString>
	<field name="NIVEL" class="java.math.BigDecimal"/>
	<field name="ESTRUTURA_ID" class="java.math.BigDecimal"/>
	<field name="EST_NOME" class="java.lang.String"/>
	<field name="CAPACIDADE" class="java.math.BigDecimal"/>
	<field name="CAPACIDADE_TOTAL" class="java.math.BigDecimal"/>
	<field name="QTD_RECUPERANDOS" class="java.math.BigDecimal"/>
	<variable name="id_1" class="java.lang.Integer" calculation="Count"/>
