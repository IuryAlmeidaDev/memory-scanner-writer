<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ListaDeConfere" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenResourceMissingType="Empty" uuid="ca5d2853-6c77-4890-b361-6e38863346bc">
	<property name="ireport.zoom" value="1.8150000000000004"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="47"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["\\subrelatorios\\ListaDeConfere\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="UNIDADE_LOGADA" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="EMISSOR" class="java.lang.String"/>
	<parameter name="NOME_DO_RELATORIO" class="java.lang.String"/>
	<parameter name="TEM_PAGINACAO" class="java.lang.Boolean">
		<defaultValueExpression><![CDATA[true]]></defaultValueExpression>
	</parameter>
	<parameter name="CABECALHO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["cabecalhos\\CabecalhoPadrao.jasper"]]></defaultValueExpression>
	</parameter>
	<parameter name="RODAPE" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["cabecalhos\\RodapePadrao.jasper"]]></defaultValueExpression>
	</parameter>
	<parameter name="ID_ESTRUTURA" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="ESTRUTURA_NOME" class="java.lang.String"/>
	<parameter name="SCHEMA" class="java.lang.String"/>
	<parameter name="PLANTOES" class="java.util.Collection" isForPrompting="false"/>
	<queryString>
		<![CDATA[select e1.id, e1.nome, e1.cela, (select count(r.id)
  from $P!{SCHEMA}.estrutura        e,
       $P!{SCHEMA}.passagem_lotacao plo,
       $P!{SCHEMA}.passagem         p,
       $P!{SCHEMA}.recuperando      r
 where plo.estrutura_id(+) = e.id
   and plo.passagem_id = p.id(+)
   and plo.data_saida is null
   and p.data_saida is null
   and p.recuperando_id = r.id(+)
 start with e.id = e1.id
connect by prior e.id = e.estruturapai_id) quantidade
from $P!{SCHEMA}.estrutura e1
start with e1.id = $P{ID_ESTRUTURA}
connect by prior e1.id = e1.estruturapai_id]]>
	</queryString>
	<field name="idEstrutura" class="java.lang.Long"/>
	<field name="nomeEstrutura" class="java.lang.String"/>
	<field name="celaBigDecimal" class="java.math.BigDecimal"/>
	<field name="quantidade" class="java.math.BigDecimal"/>
	<variable name="id_1" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{idEstrutura}]]></variableExpression>
	</variable>
	<group name="t">
		<groupExpression><![CDATA[$F{nomeEstrutura}]]></groupExpression>
		<groupHeader>
			<band height="15">
				<printWhenExpression><![CDATA[$F{quantidade}.intValue() > 0]]></printWhenExpression>
				<rectangle>
					<reportElement mode="Opaque" x="0" y="0" width="555" height="15" backcolor="#F2F2F2" uuid="91f5696a-b4b8-455e-9c76-325165d3cfc0">
						<printWhenExpression><![CDATA[$F{celaBigDecimal}.intValue() == 1]]></printWhenExpression>
					</reportElement>
					<graphicElement>
						<pen lineWidth="0.0"/>
					</graphicElement>
				</rectangle>
				<textField>
					<reportElement mode="Transparent" x="0" y="0" width="555" height="15" uuid="25c9fcff-55da-4250-a4fe-c5adee0d0eb4"/>
					<box leftPadding="1">
						<topPen lineWidth="0.25"/>
						<leftPen lineWidth="0.25"/>
						<bottomPen lineWidth="0.25"/>
						<rightPen lineWidth="0.25"/>
					</box>
					<textElement verticalAlignment="Middle">
						<font size="8" isBold="true"/>
					</textElement>
					<textFieldExpression><![CDATA["Total de recuperandos - " + $F{nomeEstrutura}+ ": " + $F{quantidade}]]></textFieldExpression>
				</textField>
			</band>
		</groupHeader>
	</group>
	<pageHeader>
		<band height="106" splitType="Stretch">
			<subreport isUsingCache="false">
				<reportElement positionType="Float" x="0" y="0" width="555" height="106" uuid="e5d91037-92bb-4da7-93b0-b845fc31124c"/>
				<subreportParameter name="UNIDADE_LOGADA">
					<subreportParameterExpression><![CDATA[$P{UNIDADE_LOGADA}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="NOME_DO_RELATORIO">
					<subreportParameterExpression><![CDATA[$P{NOME_DO_RELATORIO}]]></subreportParameterExpression>
				</subreportParameter>
				<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
				<subreportExpression><![CDATA[$P{CABECALHO}]]></subreportExpression>
			</subreport>
		</band>
	</pageHeader>
	<columnHeader>
		<band height="22">
			<textField isStretchWithOverflow="true">
				<reportElement x="5" y="0" width="545" height="20" uuid="a7f76529-7fcf-4828-bf85-e5050ab8fe53"/>
				<textElement textAlignment="Center">
					<font size="11" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{ESTRUTURA_NOME}]]></textFieldExpression>
			</textField>
		</band>
	</columnHeader>
	<detail>
		<band height="85" splitType="Stretch">
			<printWhenExpression><![CDATA[$F{celaBigDecimal}.intValue() == 1 & $F{quantidade}.intValue() > 0]]></printWhenExpression>
			<subreport isUsingCache="false">
				<reportElement x="0" y="10" width="555" height="51" uuid="fb3b10d4-88a7-4eac-b9c2-228132bf215a"/>
				<subreportParameter name="SUBREPORT_DIR">
					<subreportParameterExpression><![CDATA[$P{SUBREPORT_DIR}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="SUB_ESTRUTURA_ID">
					<subreportParameterExpression><![CDATA[$F{idEstrutura}.intValue()]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="SUB_SCHEMA">
					<subreportParameterExpression><![CDATA[$P{SCHEMA}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="SUB_PLANTOES">
					<subreportParameterExpression><![CDATA[$P{PLANTOES}]]></subreportParameterExpression>
