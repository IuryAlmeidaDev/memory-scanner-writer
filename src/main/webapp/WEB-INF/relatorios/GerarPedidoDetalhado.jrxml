<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="GerarPedidoDetalhado" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenResourceMissingType="Empty" uuid="ca5d2853-6c77-4890-b361-6e38863346bc">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["C:\\Users\\lavidicoalves.JUSTICA\\Desktop\\relatórios\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="UNIDADE_LOGADA" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="EMISSOR" class="java.lang.String"/>
	<parameter name="NOME_DO_RELATORIO" class="java.lang.String"/>
	<parameter name="TEM_PAGINACAO" class="java.lang.Boolean">
		<defaultValueExpression><![CDATA[true]]></defaultValueExpression>
	</parameter>
	<parameter name="CABECALHO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["cabecalhos\\CabecalhoPadrao.jasper"]]></defaultValueExpression>
	</parameter>
	<parameter name="RODAPE" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["cabecalhos\\RodapePadrao.jasper"]]></defaultValueExpression>
	</parameter>
	<parameter name="ID_ESTRUTURA" class="java.lang.Long"/>
	<parameter name="SCHEMA" class="java.lang.String"/>
	<parameter name="DATA" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
                L.ESTRUTURA_ID
                ,count(pas.ID) AS QTD ,sum(pas.ID) * ic.MASC_MG  AS peso
                ,a.DESCRICAO AS item, ic.MASC_MG, ic.FEM_MG,'PADRAO' AS tipo, td.DESCRICAO AS cardapio, tr.DESCRICAO AS TIPO_REFEICAO
                FROM $P!{SCHEMA}.PASSAGEM PAS
                JOIN $P!{SCHEMA}.PASSAGEM_LOTACAO L on l.PASSAGEM_ID = pas.ID
                JOIN $P!{SCHEMA}.ESTRUTURA e2 ON e2.ID = l.ESTRUTURA_ID
                JOIN $P!{SCHEMA}.CONTRATO_UNIDADE_PRISIONAL cup ON cup.UNIDADE_PRISIONAL_ID = e2.UNIDADEPRISIONAL_ID
                JOIN $P!{SCHEMA}.CARDAPIO c ON c.CONTRATO_ID = cup.CONTRATO_ID
                JOIN $P!{SCHEMA}.ITEM_CARDAPIO ic ON ic.CARDAPIO_ID = c.ID
                JOIN $P!{SCHEMA}.ALIMENTO a on a.id = ic.ALIMENTO_ID
                JOIN $P!{SCHEMA}.TIPO_DIETA td ON td.ID = c.TIPO_DIETA_ID
                JOIN $P!{SCHEMA}.TIPO_REFEICAO tr ON tr.ID = c.TIPO_REFEICAO_ID
                WHERE
                c.TIPO_REFEICAO_ID = 1 and
                td.ESPECIAL = 0 and
                c.CODG_DIA_SEMANA = 1 and
                l.ESTRUTURA_ID = 22 and
                TO_DATE('21/08/2023 10:00', 'DD/MM/YYYY hh:mi') >= l.DATA_ENTRADA AND (TO_DATE('21/08/2023 10:00', 'DD/MM/YYYY hh:mi') <= l.DATA_SAIDA OR L.DATA_SAIDA IS NULL)
                GROUP BY L.ESTRUTURA_ID, a.DESCRICAO, ic.MASC_MG, ic.FEM_MG, td.DESCRICAO,  tr.DESCRICAO
                --ORDER BY td.DESCRICAO
                union
                SELECT
                L.ESTRUTURA_ID
                ,count(dr.id) AS QTD,sum(pas.ID) * ic.MASC_MG  AS peso
                ,a.DESCRICAO AS item, ic.MASC_MG, ic.FEM_MG, 'ESPECIAL' AS TIPO,td.DESCRICAO AS cardapio, tr.DESCRICAO AS TIPO_REFEICAO
                FROM $P!{SCHEMA}.PASSAGEM PAS
                JOIN $P!{SCHEMA}.PASSAGEM_LOTACAO L on l.PASSAGEM_ID = pas.ID
                JOIN $P!{SCHEMA}.ESTRUTURA e2 ON e2.ID = l.ESTRUTURA_ID
                JOIN $P!{SCHEMA}.CONTRATO_UNIDADE_PRISIONAL cup ON cup.UNIDADE_PRISIONAL_ID = e2.UNIDADEPRISIONAL_ID
                JOIN $P!{SCHEMA}.CARDAPIO c ON c.CONTRATO_ID = cup.CONTRATO_ID
                JOIN $P!{SCHEMA}.ITEM_CARDAPIO ic ON ic.CARDAPIO_ID = c.ID
                JOIN $P!{SCHEMA}.ALIMENTO a on a.id = ic.ALIMENTO_ID
                JOIN $P!{SCHEMA}.DIETA_RECUPERANDO dr ON dr.RECUPERANDO_ID = PAS.RECUPERANDO_ID AND dr.STATUS = 1 and (dr.FIM IS null or dr.FIM > SYSDATE)
                JOIN $P!{SCHEMA}.TIPO_DIETA td ON td.ID = c.TIPO_DIETA_ID
                JOIN $P!{SCHEMA}.TIPO_REFEICAO tr ON tr.ID = c.TIPO_REFEICAO_ID
                WHERE
                c.TIPO_REFEICAO_ID = 1 and
                td.ESPECIAL = 1 and
                dr.id IS not NULL and
                c.CODG_DIA_SEMANA = 1 and
                l.ESTRUTURA_ID = 22 and
                TO_DATE('21/08/2023 10:00', 'DD/MM/YYYY hh:mi') >= l.DATA_ENTRADA AND (TO_DATE('21/08/2023 10:00', 'DD/MM/YYYY hh:mi') <= l.DATA_SAIDA OR L.DATA_SAIDA IS NULL)
                GROUP BY L.ESTRUTURA_ID, a.DESCRICAO, ic.MASC_MG, ic.FEM_MG,td.DESCRICAO,  tr.DESCRICAO
                ORDER BY ESTRUTURA_ID]]>
	</queryString>
	<field name="NIVEL" class="java.math.BigDecimal"/>
	<field name="ESTRUTURA_ID" class="java.math.BigDecimal"/>
	<field name="TIPO" class="java.lang.String"/>
	<field name="ITEM" class="java.lang.String"/>
	<field name="QTD" class="java.math.BigDecimal"/>
	<field name="PESO" class="java.math.BigDecimal"/>
