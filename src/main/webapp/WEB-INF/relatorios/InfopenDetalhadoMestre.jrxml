<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" 
              name="InfopenDetalhadoMestre" pageWidth="842" pageHeight="595" orientation="Landscape" 
              whenNoDataType="BlankPage" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <parameter name="SUBREPORT_DIR" class="java.lang.String"/>
    <parameter name="UNIDADE_LOGADA" class="java.lang.String"/>
    <parameter name="FILTRO_DETALHADO" class="java.lang.String"/>
    <parameter name="EMISSOR" class="java.lang.String"/>
    <parameter name="NOME_DO_RELATORIO" class="java.lang.String"/>
    <parameter name="CABECALHO" class="java.lang.String"/>
    <parameter name="RODAPE" class="java.lang.String"/>
    <parameter name="TEM_PAGINACAO" class="java.lang.Boolean" isForPrompting="false">
		<defaultValueExpression><![CDATA[true]]></defaultValueExpression>
	</parameter>
    <parameter name="GAMB_NULL_DS" class="net.sf.jasperreports.engine.JREmptyDataSource"/>

    
    <field name="unidade" class="java.lang.String"/>
    <field name="filtro.descricao" class="java.lang.String"/>
    <field name="recuperandos" class="java.util.Collection"/>

    
    <variable name="CONTADOR_UNIDADE" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{recuperandos} == null ? 0 : $F{recuperandos}.size()]]></variableExpression>
    </variable>

   
    <group name="unidades">
        <groupExpression><![CDATA[$F{unidade}]]></groupExpression>
        <groupHeader>
            <band height="40">
                <textField>
                    <reportElement x="0" y="0" width="802" height="20"/>
                    <textElement verticalAlignment="Middle">
                        <font isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["UNIDADE PRISIONAL: " + $F{unidade}]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="10"/>
        </groupFooter>
    </group>

   
    <pageHeader>
        <band height="106">
            <subreport>
                <reportElement x="0" y="0" width="802" height="106"/>
                <subreportParameter name="UNIDADE_LOGADA">
                    <subreportParameterExpression><![CDATA[$P{UNIDADE_LOGADA}]]></subreportParameterExpression>
                </subreportParameter>
                <subreportParameter name="NOME_DO_RELATORIO">
                    <subreportParameterExpression><![CDATA[$P{NOME_DO_RELATORIO}]]></subreportParameterExpression>
                </subreportParameter>
                <dataSourceExpression><![CDATA[$P{GAMB_NULL_DS}]]></dataSourceExpression>
                <subreportExpression><![CDATA[$P{CABECALHO}]]></subreportExpression>
            </subreport>
        </band>
    </pageHeader>

  
    <detail>
    	<band height="18" splitType="Prevent">
        	<printWhenExpression><![CDATA[
			    $P{FILTRO_DETALHADO} != null 
			    && !$P{FILTRO_DETALHADO}.trim().isEmpty()
			]]></printWhenExpression>

        	<textField isStretchWithOverflow="true">
            	<reportElement uuid="4ccfd6d9-9aeb-431d-ba9b-e27b3070e227"
                          stretchType="RelativeToBandHeight" 
                          x="0" y="0" width="802" height="18"/>
            	<textElement/>
            	<textFieldExpression><![CDATA[$P{FILTRO_DETALHADO}]]></textFieldExpression>
        	</textField>
    	</band>
        <band height="50">
            <subreport>
                <reportElement x="0" y="0" width="802" height="50"/>
                <dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource($F{recuperandos})]]></dataSourceExpression>
                <subreportExpression><![CDATA[$P{SUBREPORT_DIR} + "InfopenDetalhadoNacionalidades.jasper"]]></subreportExpression>
            </subreport>
        </band>
    </detail>

    
    <pageFooter>
        <band height="51">
            <subreport>
                <reportElement x="0" y="0" width="802" height="51"/>
                <subreportParameter name="PAGINA">
                    <subreportParameterExpression><![CDATA[$V{PAGE_NUMBER}]]></subreportParameterExpression>
                </subreportParameter>
                <subreportParameter name="EMISSOR">
                    <subreportParameterExpression><![CDATA[$P{EMISSOR}]]></subreportParameterExpression>
                </subreportParameter>
                <dataSourceExpression><![CDATA[$P{GAMB_NULL_DS}]]></dataSourceExpression>
                <subreportExpression><![CDATA[$P{RODAPE}]]></subreportExpression>
            </subreport>
            <textField>
				<reportElement uuid="21949555-196a-4d34-89dd-e4b9f2f2f2af" x="682" y="13" width="80" height="20">
					<printWhenExpression><![CDATA[new Boolean($P{TEM_PAGINACAO})]]></printWhenExpression>
				</reportElement>
				<textElement textAlignment="Right"/>
				<textFieldExpression><![CDATA["Página "+$V{PAGE_NUMBER}+" de"]]></textFieldExpression>
			</textField>
			<textField evaluationTime="Report">
				<reportElement uuid="18471924-0526-4b68-acd6-512add5df44e" x="762" y="13" width="40" height="20">
					<printWhenExpression><![CDATA[new Boolean($P{TEM_PAGINACAO})]]></printWhenExpression>
				</reportElement>
				<textElement/>
				<textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
        </band>
    </pageFooter>

   
    <summary>
        <band height="30">
            <textField>
                <reportElement x="600" y="10" width="200" height="20"/>
                <textElement textAlignment="Right">
                    <font isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Total de unidade: " + $V{CONTADOR_UNIDADE}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
