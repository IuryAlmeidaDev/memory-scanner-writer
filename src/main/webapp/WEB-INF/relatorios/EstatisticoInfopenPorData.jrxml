	<subDataset name="Idade" uuid="cdecf607-8498-4aa3-8e45-1f2eab9141a6">
		<parameter name="SCHEMA_SUB" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="UNIDADE_SUB_ID" class="java.lang.Long" isForPrompting="false"/>
		<parameter name="DATA_SAIDA" class="java.util.Date" isForPrompting="false"/>
		<queryString>
			<![CDATA[SELECT z.idade,
                    SUM(z.quantidade) AS quantidade
                FROM (
                    SELECT
                        (CASE
                            WHEN y.idade >= 18 AND y.idade <= 24 THEN 5
                            WHEN y.idade >= 25 AND y.idade <= 29 THEN 4
                            WHEN y.idade >= 30 AND y.idade <= 34 THEN 3
                            WHEN y.idade >= 35 AND y.idade <= 45 THEN 2
                            WHEN y.idade >= 46 AND y.idade <= 60 THEN 1
                            WHEN y.idade > 60 THEN 0
                        END) AS id,
                        (CASE
                            WHEN y.idade >= 18 AND y.idade <= 24 THEN 'Entre 18 e 24 anos'
                            WHEN y.idade >= 25 AND y.idade <= 29 THEN 'Entre 25 e 29 anos'
                            WHEN y.idade >= 30 AND y.idade <= 34 THEN 'Entre 30 e 34 anos'
                            WHEN y.idade >= 35 AND y.idade <= 45 THEN 'Entre 35 e 45 anos'
                            WHEN y.idade >= 46 AND y.idade <= 60 THEN 'Entre 46 e 60 anos'
                            WHEN y.idade > 60 THEN 'Acima de 60 anos'
                        END) AS idade,
                        COUNT(y.id) AS quantidade
                    FROM (
                        SELECT
                            r.id,
                            TRUNC((TRUNC(SYSDATE) - p.data_nascimento) / 365) AS idade
                        FROM
                            $P!{SCHEMA_SUB}.recuperando r
                        JOIN $P!{SCHEMA_SUB}.pessoa p ON r.pessoa_id = p.id
                        JOIN $P!{SCHEMA_SUB}.lista_todos_recuperandos l ON r.id = l.matricula
                        LEFT JOIN (
                            SELECT RECUPERANDO_ID, MAX(DATA_ENTRADA) AS ULTIMA_DATA_ENTRADA
                            FROM $P!{SCHEMA_SUB}.passagem
                            WHERE (DATA_SAIDA <= TO_DATE($P!{DATA_SAIDA}, 'DD/MM/YYYY') OR DATA_SAIDA IS NULL)
                            GROUP BY RECUPERANDO_ID
                        ) p_max ON r.id = p_max.RECUPERANDO_ID
                        LEFT JOIN $P!{SCHEMA_SUB}.passagem p2 ON p2.RECUPERANDO_ID = p_max.RECUPERANDO_ID AND p2.DATA_ENTRADA = p_max.ULTIMA_DATA_ENTRADA
                        WHERE
                            l.id_unidade = $P!{UNIDADE_SUB_ID}
                            AND r.status = 1
                    ) y
                    GROUP BY y.idade
                ) z
                GROUP BY z.idade, z.id
                ORDER BY z.id]]>
		</queryString>
		<field name="IDADE" class="java.lang.String"/>
		<field name="QUANTIDADE" class="java.math.BigDecimal"/>
	</subDataset>
	<subDataset name="TempoCondenacao" uuid="d3409d08-6f1c-40d2-a1b8-bee81865f8c6">
		<parameter name="SCHEMA_SUB" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="UNIDADE_SUB_ID" class="java.lang.Long" isForPrompting="false"/>
		<parameter name="DATA_SAIDA" class="java.util.Date" isForPrompting="false"/>
		<queryString>
			<![CDATA[SELECT z.tempo,
                    COUNT(z.id) AS quantidade
                FROM (
                    SELECT
                        y.id,
                        (CASE
                            WHEN y.dias <= 4*365 THEN 'Condenação até 04 anos'
                            WHEN y.dias > 4*365 AND y.dias <= 8*365 THEN 'Condenação maior que 04 até 08 anos'
                            WHEN y.dias > 8*365 AND y.dias <= 15*365 THEN 'Condenação maior que 08 até 15 anos'
                            WHEN y.dias > 15*365 AND y.dias <= 20*365 THEN 'Condenação maior que 15 até 20 anos'
                            WHEN y.dias > 20*365 AND y.dias <= 30*365 THEN 'Condenação maior que 20 até 30 anos'
                            WHEN y.dias > 30*365 AND y.dias <= 50*365 THEN 'Condenação maior que 30 até 50 anos'
                            WHEN y.dias > 50*365 AND y.dias <= 100*365 THEN 'Condenação maior que 50 até 100 anos'
                            WHEN y.dias > 100*365 THEN 'Acima de 100 Anos'
                        END) AS tempo
                    FROM (
                        SELECT
                            r.id,
                            (p.ano*365) + (p.mes*30) + p.dia AS dias
                        FROM
                            $P!{SCHEMA_SUB}.recuperando r
                        JOIN $P!{SCHEMA_SUB}.processo p ON r.id = p.recuperando_id
                        JOIN $P!{SCHEMA_SUB}.lista_todos_recuperandos l ON r.id = l.matricula
                        LEFT JOIN (
                            SELECT RECUPERANDO_ID, MAX(DATA_ENTRADA) AS ULTIMA_DATA_ENTRADA
                            FROM $P!{SCHEMA_SUB}.passagem
                            WHERE (DATA_SAIDA <= TO_DATE($P!{DATA_SAIDA}, 'DD/MM/YYYY') OR DATA_SAIDA IS NULL)
                            GROUP BY RECUPERANDO_ID
                        ) p_max ON r.id = p_max.RECUPERANDO_ID
                        LEFT JOIN $P!{SCHEMA_SUB}.passagem p2 ON p2.RECUPERANDO_ID = p_max.RECUPERANDO_ID AND p2.DATA_ENTRADA = p_max.ULTIMA_DATA_ENTRADA
                        WHERE
                            r.status = 1
                            AND l.id_unidade = $P!{UNIDADE_SUB_ID}
                            AND r.condicao_atual = 'CONDENADO'
                            AND p.status_processo <> 'FINALIZADO'
                            AND p.ano IS NOT NULL
                            AND p.dia IS NOT NULL
                            AND p.mes IS NOT NULL
                    ) y
                ) z
                GROUP BY z.tempo
                ORDER BY z.tempo]]>
		</queryString>
		<field name="TEMPO" class="java.lang.String"/>
		<field name="QUANTIDADE" class="java.math.BigDecimal"/>
	</subDataset>
	<subDataset name="LGBT" uuid="d3409d08-6f1c-40d2-a1b8-bee81865f8c6">
		<parameter name="SCHEMA_SUB" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="UNIDADE_SUB_ID" class="java.lang.Long" isForPrompting="false"/>
		<parameter name="DATA_SAIDA" class="java.util.Date" isForPrompting="false"/>
		<queryString>
			<![CDATA[SELECT * FROM (
                    SELECT 0 ID, DESCRICAO, QUANTIDADE
                    FROM (
                        SELECT 'Mulheres Trans' DESCRICAO, COUNT(r.id) quantidade
                        FROM $P!{SCHEMA_SUB}.recuperando r
                        JOIN $P!{SCHEMA_SUB}.lista_todos_recuperandos l ON l.matricula = r.id
                        LEFT JOIN (
                            SELECT RECUPERANDO_ID, MAX(DATA_ENTRADA) AS ULTIMA_DATA_ENTRADA
                            FROM $P!{SCHEMA_SUB}.PASSAGEM
                            WHERE (DATA_SAIDA <= TO_DATE($P!{DATA_SAIDA}, 'DD/MM/YYYY') OR DATA_SAIDA IS NULL)
                            GROUP BY RECUPERANDO_ID
                        ) p_max ON r.id = p_max.RECUPERANDO_ID
                        LEFT JOIN $P!{SCHEMA_SUB}.PASSAGEM p ON p.RECUPERANDO_ID = p_max.RECUPERANDO_ID AND p.DATA_ENTRADA = p_max.ULTIMA_DATA_ENTRADA
                        WHERE l.sexo = 'M'
                        AND r.identidade_genero_id = 2
                        AND r.status = 1
                        AND l.id_unidade = $P!{UNIDADE_SUB_ID}
                    )
                    UNION
                    SELECT 1 ID, DESCRICAO, QUANTIDADE
                    FROM (
                        SELECT 'Homens Trans' DESCRICAO, COUNT(r.id) quantidade
                        FROM $P!{SCHEMA_SUB}.recuperando r
                        JOIN $P!{SCHEMA_SUB}.lista_todos_recuperandos l ON l.matricula = r.id
                        LEFT JOIN (
                            SELECT RECUPERANDO_ID, MAX(DATA_ENTRADA) AS ULTIMA_DATA_ENTRADA
                            FROM $P!{SCHEMA_SUB}.PASSAGEM
                            WHERE (DATA_SAIDA <= TO_DATE($P!{DATA_SAIDA}, 'DD/MM/YYYY') OR DATA_SAIDA IS NULL)
                            GROUP BY RECUPERANDO_ID
                        ) p_max ON r.id = p_max.RECUPERANDO_ID
                        LEFT JOIN $P!{SCHEMA_SUB}.PASSAGEM p ON p.RECUPERANDO_ID = p_max.RECUPERANDO_ID AND p.DATA_ENTRADA = p_max.ULTIMA_DATA_ENTRADA
                        WHERE l.sexo = 'F'
                        AND r.identidade_genero_id = 2
                        AND r.status = 1
                        AND l.id_unidade = $P!{UNIDADE_SUB_ID}
                    )
                    UNION
                    SELECT 2 ID, DESCRICAO, QUANTIDADE
                    FROM (
                        SELECT 'Travesti' DESCRICAO, COUNT(r.id) quantidade
                        FROM $P!{SCHEMA_SUB}.recuperando r
                        JOIN $P!{SCHEMA_SUB}.lista_todos_recuperandos l ON l.matricula = r.id
                        LEFT JOIN (
                            SELECT RECUPERANDO_ID, MAX(DATA_ENTRADA) AS ULTIMA_DATA_ENTRADA
                            FROM $P!{SCHEMA_SUB}.PASSAGEM
                            WHERE (DATA_SAIDA <= TO_DATE($P!{DATA_SAIDA}, 'DD/MM/YYYY') OR DATA_SAIDA IS NULL)
                            GROUP BY RECUPERANDO_ID
                        ) p_max ON r.id = p_max.RECUPERANDO_ID
                        LEFT JOIN $P!{SCHEMA_SUB}.PASSAGEM p ON p.RECUPERANDO_ID = p_max.RECUPERANDO_ID AND p.DATA_ENTRADA = p_max.ULTIMA_DATA_ENTRADA
                        WHERE r.identidade_genero_id = 1
                        AND r.status = 1
                        AND l.id_unidade = $P!{UNIDADE_SUB_ID}
                    )
                    UNION
                    SELECT 3 ID, DESCRICAO, QUANTIDADE
                    FROM (
                        SELECT 'Bissexual' DESCRICAO, COUNT(r.id) quantidade
                        FROM $P!{SCHEMA_SUB}.recuperando r
                        JOIN $P!{SCHEMA_SUB}.lista_todos_recuperandos l ON l.matricula = r.id
                        LEFT JOIN (
                            SELECT RECUPERANDO_ID, MAX(DATA_ENTRADA) AS ULTIMA_DATA_ENTRADA
                            FROM $P!{SCHEMA_SUB}.PASSAGEM
                            WHERE (DATA_SAIDA <= TO_DATE($P!{DATA_SAIDA}, 'DD/MM/YYYY') OR DATA_SAIDA IS NULL)
                            GROUP BY RECUPERANDO_ID
                        ) p_max ON r.id = p_max.RECUPERANDO_ID
                        LEFT JOIN $P!{SCHEMA_SUB}.PASSAGEM p ON p.RECUPERANDO_ID = p_max.RECUPERANDO_ID AND p.DATA_ENTRADA = p_max.ULTIMA_DATA_ENTRADA
                        WHERE r.ORIENTACAO_SEXUAL_id = 3
                        AND r.status = 1
                        AND l.id_unidade = $P!{UNIDADE_SUB_ID}
                    )
                    UNION
                    SELECT 4 ID, DESCRICAO, QUANTIDADE
                    FROM (
                        SELECT 'Homossexual' DESCRICAO, COUNT(r.id) quantidade
                        FROM $P!{SCHEMA_SUB}.recuperando r
                        JOIN $P!{SCHEMA_SUB}.lista_todos_recuperandos l ON l.matricula = r.id
                        LEFT JOIN (
                            SELECT RECUPERANDO_ID, MAX(DATA_ENTRADA) AS ULTIMA_DATA_ENTRADA
                            FROM $P!{SCHEMA_SUB}.PASSAGEM
                            WHERE (DATA_SAIDA <= TO_DATE($P!{DATA_SAIDA}, 'DD/MM/YYYY') OR DATA_SAIDA IS NULL)
                            GROUP BY RECUPERANDO_ID
                        ) p_max ON r.id = p_max.RECUPERANDO_ID
                        LEFT JOIN $P!{SCHEMA_SUB}.PASSAGEM p ON p.RECUPERANDO_ID = p_max.RECUPERANDO_ID AND p.DATA_ENTRADA = p_max.ULTIMA_DATA_ENTRADA
                        WHERE r.ORIENTACAO_SEXUAL_id = 2
                        AND r.status = 1
