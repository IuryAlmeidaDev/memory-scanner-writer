	<subDataset name="Nacionalidade" uuid="bc390008-b5da-4822-b513-d6fba9db1093">
		<parameter name="SCHEMA_SUB" class="java.lang.String" isForPrompting="false"/>
		<parameter name="UNIDADE_SUB_ID" class="java.lang.Long" isForPrompting="false"/>
		<parameter name="DATA_SAIDA" class="java.util.Date" isForPrompting="false"/>
		<queryString>
			<![CDATA[select (case
                      when p.nacionalidade_id = 1 then
                        'BRASIL'
                      else
                        pa.nome
                    end) pais,
                    count(r.id) quantidade
              from $P!{SCHEMA_SUB}.recuperando r
              join $P!{SCHEMA_SUB}.pessoa p on r.pessoa_id = p.id
              join $P!{SCHEMA_SUB}.nacionalidade n on p.nacionalidade_id = n.id
              left join $P!{SCHEMA_SUB}.pais pa on p.pais_id = pa.id
              join $P!{SCHEMA_SUB}.lista_todos_recuperandos l on l.matricula = r.id
              join (select p2.recuperando_id, min(p2.data_saida) data_saida
                      from $P!{SCHEMA_SUB}.passagem p2
                     group by p2.recuperando_id) p2 on r.id = p2.recuperando_id
             where l.id_unidade = $P!{UNIDADE_SUB_ID}
               and r.status = 1
               and (p2.data_saida <= to_date($P!{DATA_SAIDA}, 'DD/MM/YYYY') or p2.data_saida is null)
             group by pa.nome, n.descricao, p.nacionalidade_id
             order by n.descricao, pais]]>
		</queryString>
		<field name="PAIS" class="java.lang.String"/>
		<field name="QUANTIDADE" class="java.math.BigDecimal"/>
	</subDataset>
	<subDataset name="Regime" uuid="d66188d8-e38d-47b8-aed8-34ce9fc51025">
		<parameter name="SCHEMA_SUB" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="UNIDADE_SUB_ID" class="java.lang.Long" isForPrompting="false"/>
		<parameter name="DATA_SAIDA" class="java.util.Date" isForPrompting="false"/>
		<queryString>
			<![CDATA[SELECT re.descricao regime, COUNT(DISTINCT r.id) quantidade
                FROM $P!{SCHEMA_SUB}.recuperando r
                JOIN $P!{SCHEMA_SUB}.regime re ON r.regime_atual_id = re.id
                JOIN $P!{SCHEMA_SUB}.lista_todos_recuperandos l ON r.id = l.matricula
                LEFT JOIN (
                    SELECT RECUPERANDO_ID, MAX(DATA_ENTRADA) AS ULTIMA_DATA_ENTRADA
                    FROM $P!{SCHEMA_SUB}.passagem
                    WHERE (DATA_SAIDA <= TO_DATE($P!{DATA_SAIDA}, 'DD/MM/YYYY') OR DATA_SAIDA IS NULL)
                    GROUP BY RECUPERANDO_ID
                ) p_max ON r.id = p_max.RECUPERANDO_ID
                LEFT JOIN $P!{SCHEMA_SUB}.passagem p ON p.RECUPERANDO_ID = p_max.RECUPERANDO_ID AND p.DATA_ENTRADA = p_max.ULTIMA_DATA_ENTRADA
                WHERE l.id_unidade = $P!{UNIDADE_SUB_ID}
                AND r.status = 1
                GROUP BY re.descricao
                ORDER BY re.descricao]]>
		</queryString>
		<field name="REGIME" class="java.lang.String"/>
		<field name="QUANTIDADE" class="java.math.BigDecimal"/>
	</subDataset>
	<subDataset name="EstadoCivil" uuid="b51f4864-e8d3-4a54-8d99-e0e32e1955f9">
		<parameter name="SCHEMA_SUB" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="UNIDADE_SUB_ID" class="java.lang.Long" isForPrompting="false"/>
		<parameter name="DATA_SAIDA" class="java.util.Date" isForPrompting="false"/>
		<queryString>
			<![CDATA[SELECT(CASE
                        WHEN ec.descricao IS NULL THEN 'Não informado'
                        ELSE ec.descricao
                    END) AS estado,
                    COUNT(DISTINCT r.id) AS quantidade
                FROM
                    $P!{SCHEMA_SUB}.recuperando r
                LEFT JOIN $P!{SCHEMA_SUB}.estado_civil ec ON r.estado_civil_id = ec.id
                JOIN $P!{SCHEMA_SUB}.lista_todos_recuperandos l ON r.id = l.matricula
                LEFT JOIN (
                    SELECT RECUPERANDO_ID, MAX(DATA_ENTRADA) AS ULTIMA_DATA_ENTRADA
                    FROM $P!{SCHEMA_SUB}.passagem
                    WHERE (DATA_SAIDA <= TO_DATE($P!{DATA_SAIDA}, 'DD/MM/YYYY') OR DATA_SAIDA IS NULL)
                    GROUP BY RECUPERANDO_ID
                ) p_max ON r.id = p_max.RECUPERANDO_ID
                LEFT JOIN $P!{SCHEMA_SUB}.passagem p ON p.RECUPERANDO_ID = p_max.RECUPERANDO_ID AND p.DATA_ENTRADA = p_max.ULTIMA_DATA_ENTRADA
                WHERE
                    l.id_unidade = $P!{UNIDADE_SUB_ID}
                    AND r.status = 1
                GROUP BY
                    ec.descricao
                ORDER BY
                    ec.descricao]]>
		</queryString>
		<field name="ESTADO" class="java.lang.String"/>
		<field name="QUANTIDADE" class="java.math.BigDecimal"/>
	</subDataset>
