	<subDataset name="Aposentados" uuid="d3409d08-6f1c-40d2-a1b8-bee81865f8c6">
		<parameter name="SCHEMA_SUB" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="UNIDADE_SUB_ID" class="java.lang.Long" isForPrompting="false"/>
		<parameter name="DATA_SAIDA" class="java.util.Date" isForPrompting="false"/>
		<queryString>
            <![CDATA[SELECT * FROM (
                    SELECT 'Aposentados' DESCRICAO, COUNT(r.id) quantidade
                    FROM $P!{SCHEMA_SUB}.recuperando r
                    JOIN $P!{SCHEMA_SUB}.lista_todos_recuperandos l ON l.matricula = r.id
                    LEFT JOIN (
                        SELECT RECUPERANDO_ID, MAX(DATA_ENTRADA) AS ULTIMA_DATA_ENTRADA
                        FROM $P!{SCHEMA_SUB}.PASSAGEM
                        WHERE (DATA_SAIDA <= TO_DATE($P!{DATA_SAIDA}, 'DD/MM/YYYY') OR DATA_SAIDA IS NULL)
                        GROUP BY RECUPERANDO_ID
                    ) p_max ON r.id = p_max.RECUPERANDO_ID
                    LEFT JOIN $P!{SCHEMA_SUB}.PASSAGEM p ON p.RECUPERANDO_ID = p_max.RECUPERANDO_ID AND p.DATA_ENTRADA = p_max.ULTIMA_DATA_ENTRADA
                    WHERE l.id_unidade = $P!{UNIDADE_SUB_ID}
                    AND trunc((trunc(sysdate) - l.data_nascimento) / 365) > 60
                    AND r.APOSENTADO = 1
                    AND r.status = 1
                )
                UNION
                SELECT * FROM (
                    SELECT 'Não Aposentados' DESCRICAO, COUNT(r.id) quantidade
                    FROM $P!{SCHEMA_SUB}.recuperando r
                    JOIN $P!{SCHEMA_SUB}.lista_todos_recuperandos l ON l.matricula = r.id
                    LEFT JOIN (
                        SELECT RECUPERANDO_ID, MAX(DATA_ENTRADA) AS ULTIMA_DATA_ENTRADA
                        FROM $P!{SCHEMA_SUB}.PASSAGEM
                        WHERE (DATA_SAIDA <= TO_DATE($P!{DATA_SAIDA}, 'DD/MM/YYYY') OR DATA_SAIDA IS NULL)
                        GROUP BY RECUPERANDO_ID
                    ) p_max ON r.id = p_max.RECUPERANDO_ID
                    LEFT JOIN $P!{SCHEMA_SUB}.PASSAGEM p ON p.RECUPERANDO_ID = p_max.RECUPERANDO_ID AND p.DATA_ENTRADA = p_max.ULTIMA_DATA_ENTRADA
                    WHERE l.id_unidade = $P!{UNIDADE_SUB_ID}
                    AND trunc((trunc(sysdate) - l.data_nascimento) / 365) > 60
                    AND r.APOSENTADO = 0
                    AND r.status = 1
                )
                UNION
                SELECT * FROM (
                    SELECT 'Não informado' DESCRICAO, COUNT(r.id) quantidade
                    FROM $P!{SCHEMA_SUB}.recuperando r
                    JOIN $P!{SCHEMA_SUB}.lista_todos_recuperandos l ON l.matricula = r.id
                    LEFT JOIN (
                        SELECT RECUPERANDO_ID, MAX(DATA_ENTRADA) AS ULTIMA_DATA_ENTRADA
                        FROM $P!{SCHEMA_SUB}.PASSAGEM
                        WHERE (DATA_SAIDA <= TO_DATE($P!{DATA_SAIDA}, 'DD/MM/YYYY') OR DATA_SAIDA IS NULL)
                        GROUP BY RECUPERANDO_ID
                    ) p_max ON r.id = p_max.RECUPERANDO_ID
                    LEFT JOIN $P!{SCHEMA_SUB}.PASSAGEM p ON p.RECUPERANDO_ID = p_max.RECUPERANDO_ID AND p.DATA_ENTRADA = p_max.ULTIMA_DATA_ENTRADA
                    WHERE l.id_unidade = $P!{UNIDADE_SUB_ID}
                    AND trunc((trunc(sysdate) - l.data_nascimento) / 365) > 60
                    AND r.APOSENTADO IS NULL
                    AND r.status = 1
                )]]>
		</queryString>
		<field name="DESCRICAO" class="java.lang.String"/>
		<field name="QUANTIDADE" class="java.math.BigDecimal"/>
	</subDataset>
	<subDataset name="Etnias" uuid="d3409d08-6f1c-40d2-a1b8-bee81865f8c6">
		<parameter name="SCHEMA_SUB" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="UNIDADE_SUB_ID" class="java.lang.Long" isForPrompting="false"/>
		<parameter name="DATA_SAIDA" class="java.util.Date" isForPrompting="false"/>
		<queryString>
			<![CDATA[SELECT E.DESCRICAO, COUNT(r.id) quantidade
                FROM $P!{SCHEMA_SUB}.recuperando r
                JOIN $P!{SCHEMA_SUB}.lista_todos_recuperandos l ON l.matricula = r.id
                JOIN $P!{SCHEMA_SUB}.ETNIA E ON E.ID = R.ID_ETNIA
                JOIN (
                    SELECT RECUPERANDO_ID, MAX(DATA_ENTRADA) AS ULTIMA_DATA_ENTRADA
                    FROM $P!{SCHEMA_SUB}.PASSAGEM
                    WHERE (DATA_SAIDA <= TO_DATE($P!{DATA_SAIDA}, 'DD/MM/YYYY') OR DATA_SAIDA IS NULL)
                    GROUP BY RECUPERANDO_ID
                ) p_max ON r.id = p_max.RECUPERANDO_ID
                JOIN $P!{SCHEMA_SUB}.PASSAGEM p2 ON p2.RECUPERANDO_ID = p_max.RECUPERANDO_ID AND p2.DATA_ENTRADA = p_max.ULTIMA_DATA_ENTRADA
                WHERE l.id_unidade = $P!{UNIDADE_SUB_ID}
                AND r.status = 1
                AND r.RACA_ID = 5
                GROUP BY E.DESCRICAO
                ORDER BY 1]]>
		</queryString>
		<field name="DESCRICAO" class="java.lang.String"/>
		<field name="QUANTIDADE" class="java.math.BigDecimal"/>
	</subDataset>
