	<subDataset name="Nacionalidade" uuid="bc390008-b5da-4822-b513-d6fba9db1093">
		<parameter name="SCHEMA_SUB" class="java.lang.String" isForPrompting="false"/>
		<parameter name="UNIDADE_SUB_ID" class="java.lang.Long" isForPrompting="false"/>
		<queryString>
			<![CDATA[select (case
         when p.nacionalidade_id = 1 then
          'BRASIL'
         else
          pa.nome
       end) pais,
       count(r.id) quantidade
  from $P!{SCHEMA_SUB}.recuperando r, $P!{SCHEMA_SUB}.pessoa p, $P!{SCHEMA_SUB}.nacionalidade n, $P!{SCHEMA_SUB}.pais pa, $P!{SCHEMA_SUB}.lista_todos_recuperandos l
 where r.pessoa_id = p.id
   and p.nacionalidade_id = n.id
   and p.pais_id = pa.id(+)
   and l.matricula = r.id
   and l.id_unidade = $P!{UNIDADE_SUB_ID}
   and r.status = 1
 group by pa.nome, n.descricao, p.nacionalidade_id
 order by n.descricao, pais]]>
		</queryString>
		<field name="PAIS" class="java.lang.String"/>
		<field name="QUANTIDADE" class="java.math.BigDecimal"/>
	</subDataset>
	<subDataset name="Regime" uuid="d66188d8-e38d-47b8-aed8-34ce9fc51025">
		<parameter name="SCHEMA_SUB" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="UNIDADE_SUB_ID" class="java.lang.Long" isForPrompting="false"/>
		<queryString>
			<![CDATA[select re.descricao regime, count(r.id) quantidade
  from $P!{SCHEMA_SUB}.recuperando r, $P!{SCHEMA_SUB}.regime re, $P!{SCHEMA_SUB}.lista_todos_recuperandos l
 where r.regime_atual_id = re.id
   and r.id = l.matricula
   and l.id_unidade = $P!{UNIDADE_SUB_ID}
   and r.status = 1
 group by re.descricao
 order by re.descricao]]>
		</queryString>
		<field name="REGIME" class="java.lang.String"/>
		<field name="QUANTIDADE" class="java.math.BigDecimal"/>
	</subDataset>
	<subDataset name="EstadoCivil" uuid="b51f4864-e8d3-4a54-8d99-e0e32e1955f9">
		<parameter name="SCHEMA_SUB" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="UNIDADE_SUB_ID" class="java.lang.Long" isForPrompting="false"/>
		<queryString>
			<![CDATA[select (case when ec.descricao is null then 'Não informado' else ec.descricao end) estado, count(r.id) quantidade from  $P!{SCHEMA_SUB}.recuperando r, $P!{SCHEMA_SUB}.estado_civil ec, $P!{SCHEMA_SUB}.lista_todos_recuperandos l
where r.estado_civil_id = ec.id(+)
and r.id = l.matricula
and l.id_unidade = $P!{UNIDADE_SUB_ID}
and r.status = 1
group by ec.descricao
order by ec.descricao]]>
		</queryString>
		<field name="ESTADO" class="java.lang.String"/>
		<field name="QUANTIDADE" class="java.math.BigDecimal"/>
	</subDataset>
