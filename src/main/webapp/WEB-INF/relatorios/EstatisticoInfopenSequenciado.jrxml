	<subDataset name="Aposentados" uuid="d3409d08-6f1c-40d2-a1b8-bee81865f8c6">
		<parameter name="SCHEMA_SUB" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="UNIDADE_SUB_ID" class="java.lang.Long" isForPrompting="false"/>
		<queryString>
			<![CDATA[SELECT 'Aposentados' DESCRICAO,  	count(r.id) quantidade
  from $P!{SCHEMA_SUB}.recuperando r,  $P!{SCHEMA_SUB}.lista_todos_recuperandos l
  where l.id_unidade = $P!{UNIDADE_SUB_ID}
 and l.matricula = r.id
 AND trunc((trunc(sysdate) - l.data_nascimento) / 365) > 60
 AND r.APOSENTADO = 1
 and r.status = 1
UNION
SELECT 'Não Aposentados' DESCRICAO,  	count(r.id) quantidade
  from $P!{SCHEMA_SUB}.recuperando r,  $P!{SCHEMA_SUB}.lista_todos_recuperandos l
  where l.id_unidade = $P!{UNIDADE_SUB_ID}
 and l.matricula = r.id
 AND trunc((trunc(sysdate) - l.data_nascimento) / 365) > 60
 AND r.APOSENTADO = 0
 and r.status = 1
UNION
SELECT 'Não informado' DESCRICAO,  	count(r.id) quantidade
  from $P!{SCHEMA_SUB}.recuperando r,  $P!{SCHEMA_SUB}.lista_todos_recuperandos l
  where l.id_unidade = $P!{UNIDADE_SUB_ID}
 and l.matricula = r.id
 AND trunc((trunc(sysdate) - l.data_nascimento) / 365) > 60
 AND r.APOSENTADO IS NULL
 and r.status = 1]]>
		</queryString>
		<field name="DESCRICAO" class="java.lang.String"/>
		<field name="QUANTIDADE" class="java.math.BigDecimal"/>
	</subDataset>
	<subDataset name="Etnias" uuid="d3409d08-6f1c-40d2-a1b8-bee81865f8c6">
		<parameter name="SCHEMA_SUB" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="UNIDADE_SUB_ID" class="java.lang.Long" isForPrompting="false"/>
		<queryString>
			<![CDATA[SELECT E.DESCRICAO,  	count(r.id) quantidade
 from $P!{SCHEMA_SUB}.recuperando r,  $P!{SCHEMA_SUB}.lista_todos_recuperandos l, $P!{SCHEMA_SUB}.ETNIA E
 where l.id_unidade = $P!{UNIDADE_SUB_ID}
 AND E.ID = R.ID_ETNIA
 and l.matricula = r.id
 and r.status = 1
 AND R.RACA_ID = 5
 GROUP BY E.DESCRICAO
 ORDER BY 1]]>
		</queryString>
		<field name="DESCRICAO" class="java.lang.String"/>
		<field name="QUANTIDADE" class="java.math.BigDecimal"/>
	</subDataset>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
