	<subDataset name="Idade" uuid="cdecf607-8498-4aa3-8e45-1f2eab9141a6">
		<parameter name="SCHEMA_SUB" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="UNIDADE_SUB_ID" class="java.lang.Long" isForPrompting="false"/>
		<queryString>
			<![CDATA[select z.idade, sum(z.quantidade) quantidade
  from (select (case
                 when y.idade >= 18 and y.idade <= 24 then
                  5
                 when y.idade >= 25 and y.idade <= 29 then
                  4
                 when y.idade >= 30 and y.idade <= 34 then
                  3
                 when y.idade >= 35 and y.idade <= 45 then
                  2
                 when y.idade >= 46 and y.idade <= 60 then
                  1
	       when y.idade > 60 then
                  0
               end) id,
	(case
                 when y.idade >= 18 and y.idade <= 24 then
                  'Entre 18 e 24 anos'
                 when y.idade >= 25 and y.idade <= 29 then
                  'Entre 25 e 29 anos'
                 when y.idade >= 30 and y.idade <= 34 then
                  'Entre 30 e 34 anos'
                 when y.idade >= 35 and y.idade <= 45 then
                  'Entre 35 e 45 anos'
                 when y.idade >= 46 and y.idade <= 60 then
                  'Entre 46 e 60 anos'
	       when y.idade > 60 then
                  'Acima de 60 anos'
               end) idade,
               count(y.id) quantidade
          from (select r.id,
                       trunc((trunc(sysdate) - p.data_nascimento) / 365) idade
                  from $P!{SCHEMA_SUB}.recuperando r, $P!{SCHEMA_SUB}.pessoa p, $P!{SCHEMA_SUB}.lista_todos_recuperandos l
                 where r.pessoa_id = p.id
                   and l.matricula = r.id
                   and l.id_unidade = $P!{UNIDADE_SUB_ID}
                   and r.status = 1) y
         group by y.idade) z
 group by z.idade, z.id
 order by z.id]]>
		</queryString>
		<field name="IDADE" class="java.lang.String"/>
		<field name="QUANTIDADE" class="java.math.BigDecimal"/>
	</subDataset>
	<subDataset name="TempoCondenacao" uuid="d3409d08-6f1c-40d2-a1b8-bee81865f8c6">
		<parameter name="SCHEMA_SUB" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="UNIDADE_SUB_ID" class="java.lang.Long" isForPrompting="false"/>
		<queryString>
			<![CDATA[select z.tempo, count(z.id) quantidade from (select y.id,
(case when y.dias <= 4*365 then 'Condenação até 04 anos'
      when y.dias > 4*365 and y.dias <= 8*365 then 'Condenação maior que 04 até 08 anos'
      when y.dias > 8*365 and y.dias <= 15*365 then 'Condenação maior que 08 até 15 anos'
      when y.dias > 15*365 and y.dias <= 20*365 then 'Condenação maior que 15 até 20 anos'
      when y.dias > 20*365 and y.dias <= 30*365 then 'Condenação maior que 20 até 30 anos'
      when y.dias > 30*365 and y.dias <= 50*365 then 'Condenação maior que 30 até 50 anos'
      when y.dias > 50*365 and y.dias <= 100*365 then 'Condenação maior que 50 até 100 anos'
      when y.dias > 100*365 then 'Acima de 100 Anos' end) tempo
from (
select r.id, (p.ano*365) + (p.mes*30) + p.dia dias from $P!{SCHEMA_SUB}.recuperando r, $P!{SCHEMA_SUB}.processo p, $P!{SCHEMA_SUB}.lista_todos_recuperandos l
where r.id = p.recuperando_id
and r.status = 1
and r.id = l.matricula
and l.id_unidade = $P!{UNIDADE_SUB_ID}
and r.condicao_atual = 'CONDENADO'
and p.status_processo <> 'FINALIZADO'
and p.ano is not null
and p.dia is not null
and p.mes is not null) y) z
group by z.tempo
order by z.tempo]]>
		</queryString>
		<field name="TEMPO" class="java.lang.String"/>
		<field name="QUANTIDADE" class="java.math.BigDecimal"/>
	</subDataset>
	<subDataset name="LGBT" uuid="d3409d08-6f1c-40d2-a1b8-bee81865f8c6">
		<parameter name="SCHEMA_SUB" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="UNIDADE_SUB_ID" class="java.lang.Long" isForPrompting="false"/>
		<queryString>
			<![CDATA[SELECT * FROM (
SELECT 0 ID, DESCRICAO, QUANTIDADE FROM
(SELECT 'Mulheres Trans' DESCRICAO,  	count(r.id) quantidade
  from $P!{SCHEMA_SUB}.recuperando r, $P!{SCHEMA_SUB}.lista_todos_recuperandos l
  where l.sexo = 'M'
   AND R.identidade_genero_id = 2
   and r.status = 1
   and l.matricula = r.id
   and l.id_unidade = $P!{UNIDADE_SUB_ID}
 )
 UNION
SELECT 1 ID, DESCRICAO, QUANTIDADE FROM
(SELECT 'Homens Trans' DESCRICAO,  	count(r.id) quantidade
  from $P!{SCHEMA_SUB}.recuperando r, $P!{SCHEMA_SUB}.lista_todos_recuperandos l
  where l.sexo = 'F'
   AND R.identidade_genero_id = 2
   and r.status = 1
   and l.matricula = r.id
   and l.id_unidade = $P!{UNIDADE_SUB_ID}
 )
 UNION
SELECT 2 ID, DESCRICAO, QUANTIDADE FROM
(SELECT 'Travesti' DESCRICAO,  	count(r.id) quantidade
  from $P!{SCHEMA_SUB}.recuperando r, $P!{SCHEMA_SUB}.lista_todos_recuperandos l
  where R.identidade_genero_id = 1
   and r.status = 1
   and l.matricula = r.id
   and l.id_unidade = $P!{UNIDADE_SUB_ID}
 )
 UNION
SELECT 3 ID, DESCRICAO, QUANTIDADE FROM
(SELECT 'Bissexual' DESCRICAO,  	count(r.id) quantidade
  from $P!{SCHEMA_SUB}.recuperando r, $P!{SCHEMA_SUB}.lista_todos_recuperandos l
  where R.ORIENTACAO_SEXUAL_id = 3
   and r.status = 1
   and l.matricula = r.id
   and l.id_unidade = $P!{UNIDADE_SUB_ID}
 )
 UNION
SELECT 4 ID, DESCRICAO, QUANTIDADE FROM
(SELECT 'Homossexual' DESCRICAO,  	count(r.id) quantidade
  from $P!{SCHEMA_SUB}.recuperando r, $P!{SCHEMA_SUB}.lista_todos_recuperandos l
  where R.ORIENTACAO_SEXUAL_id = 2
   and r.status = 1
   and l.matricula = r.id
   and l.id_unidade = $P!{UNIDADE_SUB_ID}
 )
 UNION
SELECT 5 ID, DESCRICAO, QUANTIDADE FROM
(SELECT 'Heterossexual' DESCRICAO,    count(r.id) quantidade
  from $P!{SCHEMA_SUB}.recuperando r, $P!{SCHEMA_SUB}.lista_todos_recuperandos l
  where  R.ORIENTACAO_SEXUAL_id = 1
   and r.status = 1
   and l.matricula = r.id
   and l.id_unidade = $P!{UNIDADE_SUB_ID}
 )
)ORDER BY ID]]>
		</queryString>
		<field name="DESCRICAO" class="java.lang.String"/>
		<field name="QUANTIDADE" class="java.math.BigDecimal"/>
	</subDataset>
	<subDataset name="Feminino" uuid="d3409d08-6f1c-40d2-a1b8-bee81865f8c6">
		<parameter name="SCHEMA_SUB" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="UNIDADE_SUB_ID" class="java.lang.Long" isForPrompting="false"/>
		<queryString>
			<![CDATA[SELECT 0 ID, DESCRICAO, QUANTIDADE FROM
(SELECT 'Gestante' DESCRICAO,  	count(r.id) quantidade
  from $P!{SCHEMA_SUB}.recuperando r,  $P!{SCHEMA_SUB}.lista_todos_recuperandos l
  where r.gestante = 1
  and l.id_unidade = $P!{UNIDADE_SUB_ID}
 and l.matricula = r.id
 and r.status = 1
 and l.sexo = 'F'
 )
UNION
 SELECT 1 ID, DESCRICAO, QUANTIDADE FROM
(SELECT 'Lactante' DESCRICAO,  	count(r.id) quantidade
  from $P!{SCHEMA_SUB}.recuperando r,  $P!{SCHEMA_SUB}.lista_todos_recuperandos l
  where r.lactante = 1
  and l.id_unidade = $P!{UNIDADE_SUB_ID}
 and l.matricula = r.id
 and r.status = 1
 and l.sexo = 'F'
 )
UNION
 SELECT 2 ID, DESCRICAO, QUANTIDADE FROM
(SELECT 'Mãe de menor de 12 anos' DESCRICAO,  	count(distinct r.id) quantidade
  from $P!{SCHEMA_SUB}.recuperando r, $P!{SCHEMA_SUB}.PARENTE p,  $P!{SCHEMA_SUB}.lista_todos_recuperandos l
  where p.recuperando_id = r.id
  AND P.parentesco_id = 3
  AND p.DATA_NASCIMENTO IS NOT NULL
  AND trunc((trunc(sysdate) - p.data_nascimento) / 365) < 12
  and l.id_unidade = $P!{UNIDADE_SUB_ID}
 and l.matricula = r.id
 and r.status = 1
 and l.sexo = 'F'
)
UNION
 SELECT 3 ID, DESCRICAO, QUANTIDADE FROM
(SELECT 'Mãe de PCD' DESCRICAO,  	count(distinct r.id) quantidade
  from $P!{SCHEMA_SUB}.recuperando r, $P!{SCHEMA_SUB}.PARENTE p,  $P!{SCHEMA_SUB}.lista_todos_recuperandos l
  where p.recuperando_id = r.id
  AND P.parentesco_id = 3
  AND p.filho_pcd = 1
  and l.id_unidade = $P!{UNIDADE_SUB_ID}
 and l.matricula = r.id
 and r.status = 1
 and l.sexo = 'F'
)]]>
		</queryString>
		<field name="DESCRICAO" class="java.lang.String"/>
		<field name="QUANTIDADE" class="java.math.BigDecimal"/>
	</subDataset>
